# Vercel Neon integration normally creates this automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin sign-in uses Google OAuth. Create an OAuth 2.0 Web client in Google Cloud
# Console and add <app origin>/api/auth/google/callback as an authorized redirect URI
# (e.g. http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=generate-a-long-random-secret

# Preview-only whitelist when no database is connected (comma-separated emails).
# Production administrators are whitelisted in the sec_registration.admin_users table.
ADMIN_EMAIL=admin@sec.tamu.edu

# One-time database administrator seed. Do not commit real values.
INITIAL_ADMIN_EMAIL=

# Transactional and broadcast email. Set this to "ses" for the SEC AWS account.
EMAIL_PROVIDER=ses
EMAIL_FROM=Student Engineers' Council <no-reply@sec.tamu.edu>
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Resend alternative. Set EMAIL_PROVIDER=resend to use it instead.
RESEND_API_KEY=re_xxxxxxxxx

# Optional, used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
