# Vercel Neon integration normally creates this automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin credentials. Use a long unique password in production.
ADMIN_EMAIL=admin@sec.tamu.edu
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-secret

# Transactional and broadcast email (Resend).
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=SEC Registration Hub <registration@your-verified-domain.edu>

# Optional, used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
