# Vercel Neon integration normally creates this automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Preview-only credentials when no database is connected. Production administrators
# are stored as password hashes in the sec_registration.admin_users table.
ADMIN_EMAIL=admin@sec.tamu.edu
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-secret

# One-time database administrator seed. Do not commit real values.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Transactional and broadcast email. Set this to "ses" for the SEC AWS account.
EMAIL_PROVIDER=ses
EMAIL_FROM=Student Engineers' Council <no-reply@sec.tamu.edu>
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Resend alternative. Set EMAIL_PROVIDER=resend to use it instead.
RESEND_API_KEY=re_xxxxxxxxx

# Optional, used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
